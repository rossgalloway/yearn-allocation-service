# Envio Allocation History GraphQL endpoint and optional bearer token.
ENVIO_ALLOCATION_GRAPHQL_URL=
ENVIO_ALLOCATION_GRAPHQL_TOKEN=

# Archive RPC used by the Kong-shape test endpoint for historical state reads.
RPC_URL_1=

# Postgres materialized REST read model. Use a provider-pooled connection URL.
# Local compose default: postgres://yearn:yearn@127.0.0.1:55434/yearn_allocation
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=30000
ALLOCATION_STALE_RUN_SECONDS=21600

# Keep live during setup. Switch explicitly after migrations and all three backfills succeed.
ALLOCATION_HISTORY_SOURCE=live

# Test-only: allow event/RPC materializations without certified Envio coverage or checkpoints.
ALLOCATION_ALLOW_UNCERTIFIED_MATERIALIZATION=false

# Number of latest Ethereum blocks excluded from the prototype live tail.
ALLOCATION_TEST_SAFE_BLOCK_LAG=12

# Pin production reads to one immutable Envio coverage revision.
ENVIO_ALLOCATION_COVERAGE_REVISION=

# DOA optimization history. Both values are required for optimizer records.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Draft coverage is rejected by default. Enable only for explicit research reads.
ALLOW_UNSAFE_ALLOCATION_DATA=false

# Maximum Envio source events replayed for one request.
ALLOCATION_MAX_REPLAY_EVENTS=20000

# Fail the background materialization rather than publish a partial run above this safety ceiling.
ALLOCATION_MAX_MATERIALIZATION_EVENTS=250000

# Maximum DOA history keys scanned for one chain.
DOA_MAX_REDIS_KEYS=2000

# Supported allocator-evidence chains. Configure archive RPCs for selected vaults.
RPC_URL_8453=
RPC_URL_747474=
# Optional explicit vault allowlist; defaults to the three Ethereum reference vaults.
# [{"chainId":8453,"address":"0x...","label":"Base vault"}]
ALLOCATION_VAULTS_JSON=

# Validation controls for the background CLI; normal refreshes reuse finalized state.
# ALLOCATION_FORCE_STATE_REBUILD=true
# ALLOCATION_MATERIALIZATION_TO_BLOCK=25948375
